{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eutrya",
  "version": "0.1.0",
  "identifier": "ai.eutrya.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Eutrya",
        "width": 1440,
        "height": 930,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Native swarm harness frontend",
    "longDescription": "A free and open-source desktop interface for Eutrya, a native multi-agent swarm harness.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
