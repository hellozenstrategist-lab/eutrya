{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eutrya",
  "version": "0.4.5",
  "identifier": "ai.eutrya.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eutrya",
        "width": 1440,
        "height": 930,
        "minWidth": 700,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Eutrya native swarm harness",
    "longDescription": "A free and open-source Jev-native multi-agent swarm harness with a native desktop interface.",
    "resources": {
      "../../bin/": "runtime/bin/",
      "../../src/": "runtime/src/",
      "../../extensions/": "runtime/extensions/",
      "../../package.json": "runtime/package.json",
      "../../.env.example": "runtime/.env.example",
      "../server.mjs": "runtime/desktop/server.mjs",
      "../review-board.mjs": "runtime/desktop/review-board.mjs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
